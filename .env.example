MONGODB_URI=mongodb://127.0.0.1:27017/aperture-portfolio
NEXT_PUBLIC_SITE_URL=https://your-domain.com
SESSION_SECRET=replace-with-a-long-random-secret
SEED_ADMIN_EMAIL=admin@aperture.local
SEED_ADMIN_PASSWORD=ChangeMe123!

# Set to false to remove sensitive-media handling from the site entirely: no
# safe-mode toggle in the footer and no NSFW controls anywhere in the admin.
# Any flag already stored on an asset is kept, just ignored. Defaults to true.
NEXT_PUBLIC_ENABLE_NSFW=true

# Where the raw analytics hit logs are written, one file per day. Defaults to
# ./logs/analytics. Point this at a persistent volume if the app filesystem is
# ephemeral, or the summaries cannot be rebuilt.
ANALYTICS_LOG_DIR=

# Lets an external cron call GET/POST /api/analytics/process without an admin
# session. Leave blank to require one — the app already runs the job on a timer,
# so this is only needed on a host where that timer does not survive.
ANALYTICS_CRON_SECRET=
